# Copy this file to .dev.vars to exercise the contact form in a local
# Cloudflare Pages preview (`vp run preview:pages`). Only Wrangler reads this
# file -- `vp dev` reads .env, so copy the PUBLIC_TURNSTILE_SITE_KEY line below
# into .env as well if you want the form under `vp dev`.
# For setup and deployment details, see README.md.

# Cloudflare's published always-passes Turnstile test keys, so a fresh copy of
# this file renders and submits a working widget locally.
PUBLIC_TURNSTILE_SITE_KEY='1x00000000000000000000AA'
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'

# Replace these before a local run actually sends mail.
RESEND_API_KEY='re_your_api_key'
CONTACT_TO_EMAIL='your-recipient@example.com'
CONTACT_FROM_EMAIL='your-sender@example.com'
