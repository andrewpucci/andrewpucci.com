# Copy this file to .dev.vars before running `vp run preview:pages` locally.
# Do not create a .env file alongside it: Wrangler loads only one local
# environment file. Never commit either file.
#
# Configure every value in the Cloudflare Pages dashboard for both Preview and
# Production. The public site key is an environment variable; the server-only
# values below are encrypted secrets.

# Public: safe to expose client-side, used to render the Turnstile widget.
PUBLIC_TURNSTILE_SITE_KEY='1x00000000000000000000AA'

# Server-only values for the contact form.
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'
RESEND_API_KEY='re_123'
CONTACT_TO_EMAIL='hi@andrewpucci.com'
CONTACT_FROM_EMAIL='contact@andrewpucci.com'
