{
  "name": "andrewpucci.com",
  "version": "6.2.0",
  "description": "A personal portfolio site for Andrew Pucci",
  "author": "Andrew Pucci",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "npm run updatedb && rimraf dist && NODE_ENV=development eleventy --serve",
    "prod": "npm run updatedb && rimraf dist && NODE_ENV=production eleventy",
    "build": "npm run updatedb && rimraf dist && NODE_ENV=development eleventy",
    "serve": "npx @11ty/eleventy --serve --port=8080",
    "test": "npm run lint && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:update": "vitest -u",
    "test:integration": "web-test-runner test/**/*.test.js --node-resolve --playwright",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test && npm run test:e2e -- --retries=2",
    "lint": "npm run lint:oxlint && npm run format:check",
    "lint:fix": "npm run lint:oxlint:fix && npm run format",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:staged": "lint-staged",
    "updatedb": "npx update-browserslist-db@latest",
    "playwright:install": "npx playwright install"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewpucci/andrewpucci.com"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.3.1",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.7.2",
    "terser": "^5.46.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@oxlint/migrate": "^1.71.0",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "autoprefixer": "^10.5.2",
    "cssnano": "^8.0.2",
    "eleventy-plugin-rev": "^2.0.0",
    "eleventy-sass": "^3.0.0-beta.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-security": "^4.0.0",
    "happy-dom": "^20.8.9",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^4.1.9"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,scss,css,html}": [
      "oxfmt"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  }
}
