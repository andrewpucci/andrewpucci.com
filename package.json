{
  "name": "andrewpucci.com",
  "version": "6.2.0",
  "description": "A personal portfolio site for Andrew Pucci",
  "author": "Andrew Pucci",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "npm run updatedb && rimraf dist && NODE_ENV=development eleventy --serve",
    "prod": "npm run updatedb && rimraf dist && NODE_ENV=production eleventy",
    "build": "npm run updatedb && rimraf dist && NODE_ENV=development eleventy",
    "serve": "npx @11ty/eleventy --serve --port=8080",
    "test": "npm run lint && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:update": "vitest -u",
    "test:integration": "web-test-runner test/**/*.test.js --node-resolve --playwright",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test && npm run test:e2e -- --retries=2",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:staged": "lint-staged",
    "updatedb": "npx update-browserslist-db@latest",
    "playwright:install": "npx playwright install"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewpucci/andrewpucci.com"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.7",
    "dotenv": "^17.2.3",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.7.2",
    "terser": "^5.44.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "@eslint/js": "^9.39.1",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^4.0.8",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.2",
    "eleventy-plugin-rev": "^2.0.0",
    "eleventy-sass": "^3.0.0-beta.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.0",
    "sass": "^1.93.3",
    "stylelint": "^16.21.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "vitest": "^4.0.8"
  }
}
