{
  "name": "andrewpucci.com",
  "version": "6.2.0",
  "description": "A personal portfolio site for Andrew Pucci",
  "author": "Andrew Pucci",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --check && vite build",
    "preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "npm run lint && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:update": "vitest -u",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:report": "playwright show-report",
    "test:ci": "npm run test && npm run test:e2e -- --retries=2",
    "lint": "npm run lint:oxlint && npm run format:check",
    "lint:fix": "npm run lint:oxlint:fix && npm run format",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:staged": "lint-staged",
    "updatedb": "npx update-browserslist-db@latest",
    "playwright:install": "npx playwright install",
    "legacy:dev": "npm run updatedb && rimraf dist && NODE_ENV=development eleventy --serve",
    "legacy:prod": "npm run updatedb && rimraf dist && NODE_ENV=production eleventy",
    "legacy:build": "npm run updatedb && rimraf dist && NODE_ENV=development eleventy",
    "legacy:serve": "npx @11ty/eleventy --serve --port=8080"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewpucci/andrewpucci.com"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.3.1",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.7.2",
    "terser": "^5.46.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@chromatic-com/storybook": "^5.2.1",
    "@oxlint/migrate": "^1.71.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/sveltekit": "^10.4.6",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@terrazzo/cli": "^2.4.0",
    "@terrazzo/plugin-css": "^2.4.0",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "cssnano": "^8.0.2",
    "eleventy-plugin-rev": "^2.0.0",
    "eleventy-sass": "^3.0.0-beta.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-security": "^4.0.0",
    "happy-dom": "^20.8.9",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "mdsvex": "^0.12.7",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "simple-git-hooks": "^2.13.1",
    "storybook": "^10.4.6",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vitest-browser-svelte": "^2.1.1",
    "wrangler": "^4.97.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.svelte": [
      "oxlint --fix"
    ],
    "*.{js,mjs,cjs,ts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,scss,css,html}": [
      "oxfmt"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.33.5": true,
    "sharp@0.34.5": true,
    "workerd@1.20260630.1": true,
    "@parcel/watcher@2.5.1": true
  }
}
