{
  "color": {
    "pink": {
      "500": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.8314, 0.1333, 0.4549] },
        "$description": "Precision Pink. The sole saturated color in the palette."
      },
      "600": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.702, 0.1137, 0.3882] },
        "$description": "Precision Pink, ~10% darker. Button hover/focus background."
      }
    },
    "gray": {
      "700": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.2863, 0.3137, 0.3412] },
        "$description": "Slate. Secondary text, hover states."
      },
      "900": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.1294, 0.1451, 0.1608] },
        "$description": "Ink. Primary text, headings."
      },
      "900-a12": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1294, 0.1451, 0.1608],
          "alpha": 0.125
        },
        "$description": "Ink at ~12.5% alpha. Card border."
      }
    },
    "white": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1] },
      "$description": "Surface. Cards, content areas."
    },
    "offwhite": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9804, 0.9804] },
      "$description": "Body Background. Imperceptibly warm near-white."
    },
    "brand": {
      "primary": { "$type": "color", "$value": "{color.pink.500}" },
      "primary-hover": { "$type": "color", "$value": "{color.pink.600}" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.gray.900}" },
      "secondary": { "$type": "color", "$value": "{color.gray.700}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.white}" },
      "page": { "$type": "color", "$value": "{color.offwhite}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "{color.gray.900-a12}" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 0.28125, "unit": "rem" } },
    "2": { "$type": "dimension", "$value": { "value": 0.5625, "unit": "rem" } },
    "3": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
    "4": { "$type": "dimension", "$value": { "value": 1.6875, "unit": "rem" } },
    "5": { "$type": "dimension", "$value": { "value": 2.53125, "unit": "rem" } },
    "6": { "$type": "dimension", "$value": { "value": 3.375, "unit": "rem" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
    "md": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } },
    "lg": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
  },
  "shadow": {
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "{color.gray.900-a12}",
        "offsetX": { "value": 0, "unit": "rem" },
        "offsetY": { "value": 1, "unit": "rem" },
        "blur": { "value": 2, "unit": "rem" },
        "spread": { "value": 0, "unit": "rem" }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Atkinson Hyperlegible Next Variable",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineheight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "snug": { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.5 }
    },
    "letterspacing": {
      "normal": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
    },
    "size": {
      "display-min": { "$type": "dimension", "$value": { "value": 1.975, "unit": "rem" } },
      "display-max": { "$type": "dimension", "$value": { "value": 3.5, "unit": "rem" } },
      "headline-min": { "$type": "dimension", "$value": { "value": 1.375, "unit": "rem" } },
      "headline-max": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } },
      "title": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
      "body": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
      "label": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$description": "Hero headlines only, never section titles. DTCG dimension values can't express a fluid clamp(), so fontSize here is the floor of the scale (font.size.display-min); the CSS foundation composes the actual clamp(display-min, ..., display-max) rule from the paired tokens.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.display-min}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.lineheight.tight}",
        "letterSpacing": "{font.letterspacing.normal}"
      }
    },
    "headline": {
      "$type": "typography",
      "$description": "H1-level page titles and major resume section names. See typography.display for why fontSize is the floor of a fluid scale (font.size.headline-min/-max).",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.headline-min}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.lineheight.snug}",
        "letterSpacing": "{font.letterspacing.normal}"
      }
    },
    "title": {
      "$type": "typography",
      "$description": "H4-H6 section headings.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.title}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.lineheight.normal}",
        "letterSpacing": "{font.letterspacing.normal}"
      }
    },
    "body": {
      "$type": "typography",
      "$description": "All prose. Never reduce below this size.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.body}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.lineheight.relaxed}",
        "letterSpacing": "{font.letterspacing.normal}"
      }
    },
    "label": {
      "$type": "typography",
      "$description": "Navigation links, cite attributions, card metadata.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.label}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.lineheight.normal}",
        "letterSpacing": "{font.letterspacing.normal}"
      }
    }
  },
  "button": {
    "primary": {
      "background": { "$type": "color", "$value": "{color.brand.primary}" },
      "background-hover": { "$type": "color", "$value": "{color.brand.primary-hover}" },
      "foreground": { "$type": "color", "$value": "{color.surface.default}" },
      "radius": { "$type": "dimension", "$value": "{radius.md}" },
      "padding-block": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } },
      "padding-inline": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } }
    }
  },
  "card": {
    "background": { "$type": "color", "$value": "{color.surface.default}" },
    "border-color": { "$type": "color", "$value": "{color.border.subtle}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "padding": { "$type": "dimension", "$value": "{space.3}" }
  },
  "nav": {
    "link": {
      "color-default": { "$type": "color", "$value": "{color.text.default}" },
      "color-hover": { "$type": "color", "$value": "{color.text.secondary}" },
      "color-active": { "$type": "color", "$value": "{color.brand.primary}" }
    }
  },
  "footer": {
    "background": { "$type": "color", "$value": "{color.brand.primary}" },
    "foreground": { "$type": "color", "$value": "{color.surface.default}" },
    "padding-block": { "$type": "dimension", "$value": "{space.6}" }
  },
  "timeline": {
    "rule-color": { "$type": "color", "$value": "{color.text.default}" },
    "dot-color": { "$type": "color", "$value": "{color.brand.primary}" },
    "dot-size": { "$type": "dimension", "$value": { "value": 0.625, "unit": "rem" } }
  }
}
