{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "andrewpucci-com",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_als"],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEJlE6Qi5n81J3rN",
  },
  // Backs the contact form's rate limiter (ADR-0003). A Durable Object was
  // tried first, but @sveltejs/adapter-cloudflare's generated _worker.js
  // only exports `default` -- there's no way to also export a named DO
  // class from the same script this binding would point at, short of a
  // second deployed Worker or a Pages->Workers migration. KV needs no class
  // hosting, just this data binding, so it fits the existing single-Pages-
  // project setup. See docs/adr/0003-security-posture.md's amendment.
  "kv_namespaces": [
    {
      "binding": "CONTACT_FORM_RATE_LIMITER",
      "id": "89c08762de7349fc9d28d433fac42c49",
    },
  ],
}
