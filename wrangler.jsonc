{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "andrewpucci-com",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_als"],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  // No "ratelimits" block: Pages Functions do not support the rate limit
  // binding. Declaring it here bound CONTACT_FORM_RATE_LIMITER under local
  // `wrangler pages dev` but not in the deployed Pages runtime, and that
  // local-only fidelity gap is what hid the contact-form 500. The contact
  // action now treats the binding as optional. ADR-0003 still calls for
  // worker-level rate limiting -- see README.md's Deployment section.
}
